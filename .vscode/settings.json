{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.cst": "plaintext",
    "*.sdc": "tcl",
    "*.vh": "verilog"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "firmware/fpga/sim/build": true
  },

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/firmware/pi",
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/firmware/pi"],

  "verilog.linting.linter": "iverilog",
  "verilog.linting.iverilog.arguments": "-g2005 -DSIMULATION -I firmware/fpga/sim",
  "verilog.linting.iverilog.runAtFileLocation": false,

  "[python]": { "editor.rulers": [100] },
  "[verilog]": {
    "editor.rulers": [
      100
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
